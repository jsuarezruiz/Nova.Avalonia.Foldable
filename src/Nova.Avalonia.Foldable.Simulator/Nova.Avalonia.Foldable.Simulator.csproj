<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>Nova.Avalonia.Foldable.Simulator</RootNamespace>
    <Title>Nova Avalonia Foldable Simulator</Title>
    <PackageTags>avalonia;avaloniaui;foldable;simulator;desktop;iphone-duo;hinge;dual-screen</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Description>A desktop window that simulates the iPhone Duo for Nova.Avalonia.Foldable apps: postures, a hinge you can drag, and the device folding in 3D.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nova.Avalonia.Foldable\Nova.Avalonia.Foldable.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>

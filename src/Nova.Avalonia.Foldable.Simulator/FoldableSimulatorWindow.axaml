<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sim="using:Nova.Avalonia.Foldable.Simulator"
        x:Class="Nova.Avalonia.Foldable.Simulator.FoldableSimulatorWindow"
        Title="Foldable simulator"
        Width="1320"
        Height="900"
        Background="#FF0B0B10"
        RequestedThemeVariant="Dark">

  <!-- The app's styles apply to every window, this one too, so the simulator's classes are prefixed to
       keep them from matching the app's. -->
  <Window.Styles>
    <Style Selector="TextBlock.sim-eyebrow">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="LetterSpacing" Value="1.5" />
      <Setter Property="Foreground" Value="#FF8A8A99" />
    </Style>

    <Style Selector="RadioButton.sim-preset">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Card"
                  Background="#FF15151D"
                  BorderBrush="#FF26262F"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="12,9">
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Setter Property="Margin" Value="4" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="RadioButton.sim-preset:pointerover /template/ Border#Card">
      <Setter Property="BorderBrush" Value="#FF44444F" />
    </Style>
    <Style Selector="RadioButton.sim-preset:checked /template/ Border#Card">
      <Setter Property="Background" Value="#FF1F1B26" />
      <Setter Property="BorderBrush" Value="#FFD4A1FF" />
    </Style>

    <Style Selector="TextBlock.sim-preset-title">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBlock.sim-preset-hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#FF8A8A99" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.sim-readout">
      <Setter Property="FontFamily" Value="Menlo, Consolas, monospace" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#FFC9C9D4" />
      <Setter Property="Margin" Value="0,2" />
    </Style>

    <Style Selector="TextBlock.sim-note">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="LineHeight" Value="17" />
      <Setter Property="Foreground" Value="#FF8A8A99" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Button.sim-play">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0,10" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Background" Value="#FFD4A1FF" />
      <Setter Property="Foreground" Value="#FF0B0B10" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.sim-play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFE2BFFF" />
      <Setter Property="Foreground" Value="#FF0B0B10" />
    </Style>
    <!-- Disabled for a device without a hinge; dimmed rather than recolored. -->
    <Style Selector="Button.sim-play:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Button.sim-play:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFD4A1FF" />
      <Setter Property="Foreground" Value="#FF0B0B10" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="*,320">

    <!-- The device, scaled down when the window is too small. Turning the device for the rotated
         postures turns its layout too, so the scale follows the rotation. -->
    <Viewbox StretchDirection="DownOnly">
      <LayoutTransformControl Name="Rotator">
        <!-- The margin leaves room for the shadow and for the half that turns toward the viewer. -->
        <sim:FoldableDeviceView Name="Device" Margin="90,110,90,130" />
      </LayoutTransformControl>
    </Viewbox>

    <!-- The simulator's controls. -->
    <Border Grid.Column="1" Background="#FF101017" BorderBrush="#FF1E1E27" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <StackPanel Margin="24,28,24,24">
          <TextBlock Classes="sim-eyebrow" Text="NOVA.AVALONIA.FOLDABLE" />
          <TextBlock Text="Foldable simulator"
                     Margin="0,4,0,4"
                     FontSize="24"
                     Foreground="White" />
          <TextBlock Classes="sim-note"
                     Text="Feeds a simulated fold to the app through the same API the iOS and Android providers use." />

          <TextBlock Classes="sim-eyebrow" Text="POSTURE" Margin="0,24,0,6" />
          <UniformGrid Name="PresetList" Columns="2" Margin="-4,0" />

          <TextBlock Classes="sim-eyebrow" Text="HINGE ANGLE" Margin="0,18,0,4" />
          <Grid ColumnDefinitions="*,Auto">
            <Slider Name="AngleSlider" Focusable="False" AutomationProperties.Name="Hinge angle" Minimum="0" Maximum="180" Value="180" />
            <TextBlock Name="AngleText"
                       Grid.Column="1"
                       Width="42"
                       VerticalAlignment="Center"
                       TextAlignment="Right"
                       FontSize="13"
                       Foreground="White" />
          </Grid>
          <TextBlock Classes="sim-note"
                     Text="0° closes the device and 180° lays it flat, as on the real hinge. You can also drag the device: grab the grip on either edge, or the half that's turned, and fold it. Click the turned half to look at it." />

          <Button Name="PlayButton" Classes="sim-play" Focusable="False" Content="Open the device" Margin="0,20,0,0" />

          <TextBlock Classes="sim-eyebrow" Text="WHAT THE APP SEES" Margin="0,28,0,8" />
          <Border Background="#FF15151D" CornerRadius="10" Padding="14,10">
            <StackPanel Name="Readout" />
          </Border>

          <TextBlock Classes="sim-note"
                     Margin="0,16,0,0"
                     FontSize="10"
                     LineHeight="15"
                     Text="Keys: 1 to 6 pick a posture, left and right arrows move the hinge (hold Shift for 1°)." />

          <TextBlock Classes="sim-note"
                     Margin="0,16,0,0"
                     FontSize="10"
                     LineHeight="15"
                     Foreground="#FF5E5E6B"
                     Text="Screen sizes and the 40pt fold are the iPhone Duo's, as reported on iOS 27.1. Safe-area insets aren't simulated. While the device is folded, the turned half shows the app but doesn't take clicks." />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>

</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <!-- DesktopOnly=true skips the mobile targets, for machines without the iOS and Android workloads (Linux CI, docs). -->
    <TargetFrameworks Condition="'$(DesktopOnly)' != 'true'">$(TargetFrameworks);net10.0-ios;net10.0-android</TargetFrameworks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>Nova.Avalonia.Foldable</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23</SupportedOSPlatformVersion>
    <Description>Foldable support for Avalonia on iOS (iPhone Duo) and Android: posture, hinge angle, fold bounds and a fold-aware TwoPaneView.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <!-- Its own README: nuget.org renders Markdown only, with absolute links and images from a few hosts. -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'ios'">
    <ProjectReference Include="..\Nova.Avalonia.Foldable.Bindings.iOS\Nova.Avalonia.Foldable.Bindings.iOS.csproj" />
  </ItemGroup>

  <!-- Jetpack WindowManager: FoldingFeature and the Java-friendly callback adapter. -->
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'android'">
    <PackageReference Include="Xamarin.AndroidX.Window" />
    <PackageReference Include="Xamarin.AndroidX.Window.WindowJava" />
    <!-- Aligns with the AndroidX Core that Window pulls in; an older Core.Ktx duplicates its classes. -->
    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" />
    <!-- Window brings Lifecycle 2.11 and Avalonia.Android the rest of Lifecycle at 2.10, whose packages only
         accept 2.10; referencing them here gives apps one Lifecycle version instead of NU1608 warnings. -->
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState.Android" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetPlatformIdentifier)' != 'ios'">
    <Compile Remove="Platforms\iOS\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetPlatformIdentifier)' != 'android'">
    <Compile Remove="Platforms\Android\**" />
  </ItemGroup>
</Project>

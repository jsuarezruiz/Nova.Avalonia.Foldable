<Project>
  <!--
    These classes only exist from iOS 27.1 and are resolved at runtime. Ignoring their native symbols
    keeps apps linkable against older SDKs.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <ReferenceNativeSymbol Include="UIHinge;UIHingeInteraction;UIHingeInteractionUpdate;UIViewReservedRegion;UIViewReservedRegionIdentifier;UIViewReservedRegionKind"
                           SymbolType="ObjectiveCClass"
                           SymbolMode="Ignore" />
  </ItemGroup>
</Project>

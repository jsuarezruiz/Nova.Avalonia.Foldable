{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "Nova.Avalonia.Foldable/Nova.Avalonia.Foldable.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "Configuration": "Release",
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "logo.png",
          "favicon.png"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Nova.Avalonia.Foldable",
      "_appTitle": "Nova.Avalonia.Foldable",
      "_appLogoPath": "logo.png",
      "_appFaviconPath": "favicon.png",
      "_enableSearch": true
    }
  }
}

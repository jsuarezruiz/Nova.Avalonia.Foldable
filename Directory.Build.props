<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Authors>Javier Suárez</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>avalonia;foldable;iphone-duo;pixel-fold;twopaneview;hinge;dual-screen</PackageTags>
    <VersionPrefix>0.1.0</VersionPrefix>
    <PackageProjectUrl>https://jsuarezruiz.github.io/Nova.Avalonia.Foldable/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jsuarezruiz/Nova.Avalonia.Foldable</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>

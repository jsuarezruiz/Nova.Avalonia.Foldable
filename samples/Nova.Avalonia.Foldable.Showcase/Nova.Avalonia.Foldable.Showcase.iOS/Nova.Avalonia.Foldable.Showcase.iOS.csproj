<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>com.nova.avalonia.foldable.showcase</ApplicationId>
    <ApplicationTitle>Guide To the Stars</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AppIcon>AppIcon</AppIcon>
    <!-- The .NET for iOS workload expects an older Xcode than the 27.1 the iPhone Duo simulator needs. -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
  </PropertyGroup>

  <ItemGroup>
    <BundleResource Include="Resources/LaunchMark.png" Link="LaunchMark.png" />
    <InterfaceDefinition Include="Resources/LaunchScreen.xib" Link="LaunchScreen.xib" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
    <!-- Avalonia.iOS brings in SkiaSharp's managed API but not its iOS native framework. -->
    <PackageReference Include="SkiaSharp.NativeAssets.iOS" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nova.Avalonia.Foldable.Showcase\Nova.Avalonia.Foldable.Showcase.csproj" />
    <ProjectReference Include="..\..\..\src\Nova.Avalonia.Foldable\Nova.Avalonia.Foldable.csproj" />
  </ItemGroup>
</Project>

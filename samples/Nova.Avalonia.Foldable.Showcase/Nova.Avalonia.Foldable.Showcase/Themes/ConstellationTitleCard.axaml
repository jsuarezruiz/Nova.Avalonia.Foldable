<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Nova.Avalonia.Foldable.Showcase.Controls">

  <ControlTheme x:Key="{x:Type controls:ConstellationTitleCard}" TargetType="controls:ConstellationTitleCard">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel HorizontalAlignment="Center">

          <!-- The spaces come from the original, which used them to dodge a Flutter Hero bug.
               Keep them: they set the list's ragged alignment and the flight bounds. -->
          <controls:OutlinedText Name="PART_Title"
                                 Text="{Binding $parent[controls:ConstellationTitleCard].Constellation.Title, StringFormat='  {0}  '}"
                                 FontFamily="{StaticResource TitleFont}"
                                 FontSize="42"
                                 LineHeight="54.6"
                                 HorizontalAlignment="Center"
                                 Foreground="{StaticResource StarInkBrush}" />

          <TextBlock Name="PART_Subtitle"
                     Text="{Binding $parent[controls:ConstellationTitleCard].Constellation.Subtitle}"
                     FontFamily="{StaticResource ContentFont}"
                     FontSize="16"
                     LineHeight="22.857143"
                     LetterSpacing="0.25"
                     HorizontalAlignment="Center"
                     Foreground="{StaticResource StarInkBrush}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <!-- The red entries are stroked rather than filled. -->
    <Style Selector="^:red /template/ controls|OutlinedText#PART_Title">
      <Setter Property="IsOutlined" Value="True" />
      <Setter Property="Foreground" Value="{StaticResource RedInkBrush}" />
    </Style>

    <Style Selector="^:red /template/ TextBlock#PART_Subtitle">
      <Setter Property="Foreground" Value="{StaticResource RedInkBrush}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nova.Avalonia.Foldable.Showcase.Views.ListPage"
             ClipToBounds="True">

  <UserControl.Styles>
    <Style Selector="Button.constellationRow">
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Content="{TemplateBinding Content}"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
    </Style>
  </UserControl.Styles>

  <!-- MaxWidth, not Width: Flutter clamps the 600 to the screen. -->
  <Panel MaxWidth="600" HorizontalAlignment="Stretch">

    <ScrollViewer Name="Scroller" VerticalScrollBarVisibility="Hidden">
      <ItemsControl Name="Entries" Margin="0,150,0,200" />
    </ScrollViewer>

    <!-- Black at both ends, so entries fade out rather than being cut off. -->
    <Border IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
          <GradientStop Color="Black" Offset="0" />
          <GradientStop Color="#00000000" Offset="0.2" />
          <GradientStop Color="#00000000" Offset="0.8" />
          <GradientStop Color="Black" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <TextBlock Text="GUIDE TO THE STARS"
               Width="180"
               Margin="16,12,0,0"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               TextWrapping="Wrap"
               FontFamily="{StaticResource HeaderFont}"
               FontSize="28"
               LetterSpacing="0.25"
               LineHeight="29.4"
               ClipToBounds="False"
               Foreground="{StaticResource StarInkBrush}" />

    <TextBlock Text="New York City (USA, NY) 40.71 °N - 74.01 °W"
               Width="120"
               Margin="0,8,16,0"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               TextAlignment="Right"
               TextWrapping="Wrap"
               FontFamily="{StaticResource ContentFont}"
               FontSize="10"
               LetterSpacing="0.25"
               LineHeight="18"
               Foreground="{StaticResource MutedInkBrush}" />
  </Panel>

</UserControl>

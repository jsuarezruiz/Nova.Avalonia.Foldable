<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Nova.Avalonia.Foldable.Showcase.Controls"
             xmlns:views="using:Nova.Avalonia.Foldable.Showcase.Views"
             x:Class="Nova.Avalonia.Foldable.Showcase.Views.DetailPage"
             x:DataType="views:DetailPage">

  <DockPanel Margin="0,24,0,0" HorizontalAlignment="Center">

    <!-- Centered, not stretched, so the flying card targets the name rather than the page's left edge. -->
    <controls:ConstellationTitleCard Name="TitleCard"
                                     DockPanel.Dock="Top"
                                     HorizontalAlignment="Center"
                                     Constellation="{Binding Constellation}"
                                     IsRedMode="{Binding IsRedMode}" />

    <Panel DockPanel.Dock="Bottom" Height="36" />

    <!-- Only needed on one screen; with two panes the list is always beside the detail. -->
    <Button DockPanel.Dock="Bottom"
            IsVisible="{Binding IsReturnVisible}"
            Theme="{StaticResource ReturnButtonTheme}"
            Content="Return to List"
            HorizontalAlignment="Center"
            Click="OnReturnClicked" />

    <!-- Chart and lettering share one clock so their reveals overlap. -->
    <Panel Name="Chart" RenderTransformOrigin="50%,50%">
      <Image Source="{Binding ChartImage}" Stretch="Uniform" />
      <Image Name="Lettering" Source="{Binding LabelImage}" Stretch="Uniform" Opacity="0" />
    </Panel>
  </DockPanel>

</UserControl>
